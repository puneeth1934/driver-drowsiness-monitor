# =============================================================================
# Driver Drowsiness Detection System — Cloud Configuration Template
# =============================================================================
# Copy this file to .env and configure your Firebase credentials.
# NEVER commit your actual .env file or private key JSON file to GitHub!
# =============================================================================

# Unique vehicle identifier for this monitoring device
DEVICE_ID=DDS-VEM-001

# Firebase Realtime Database URL
# Example: https://your-project-id-default-rtdb.firebaseio.com/
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/

# Path to the downloaded Firebase Admin SDK Service Account JSON key
# Place the downloaded JSON file in your project directory (e.g., serviceAccountKey.json)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Optional: Cloud upload frequency in seconds (default is 1.0 second heartbeat)
FIREBASE_SYNC_INTERVAL_SEC=1.0

